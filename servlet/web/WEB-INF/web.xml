<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
   Verified Digital Skill-Badge Portal — deployment descriptor

   Every servlet is declared and mapped explicitly here rather than with
   @WebServlet annotations. That is a deliberate choice for this PBL:
   one of the stated objectives is "correctly deploy a servlet on Apache
   Tomcat with proper servlet mapping", and a single descriptor makes
   the whole URL surface of the application readable in one screen.

   Servlet API 3.1 — the version shipped with Tomcat 8.5, which is the
   Tomcat bundled with XAMPP. Note the javax.servlet namespace; Tomcat
   10 and later renamed it to jakarta.servlet and this descriptor would
   need its version bumped to match.
  =====================================================================
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>Verified Digital Skill-Badge Portal</display-name>
  <description>
    Badge issuance and verification. The verification lookup exists twice:
    here as a Java Servlet, and again as a Python CGI script under
    Apache HTTP Server, so the two request lifecycles can be benchmarked
    against each other.
  </description>

  <!-- ================================================================
       Lifecycle listener.
       Opens the JDBC connection pool once, at application startup.
       This is the hook CGI has no equivalent of.
       ================================================================ -->
  <listener>
    <listener-class>com.badgeportal.AppListener</listener-class>
  </listener>

  <!-- ================================================================
       Access control.

       Mapped ONLY to the two protected prefixes, never to /*. That is
       deliberate and load-bearing: /api/verify is the benchmarked
       endpoint, and its CGI twin has no concept of a session. If
       authentication ever applied to it, the two implementations would
       stop returning identical JSON and bench/benchmark.py would abort
       at its parity check.

       Mapping the filter narrowly means the verification endpoint is
       not merely excluded from the rules, it is outside their reach.
       See the comment block in AuthFilter.java.
       ================================================================ -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.badgeportal.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/student/*</url-pattern>
  </filter-mapping>

  <!-- ================================================================
       Verification lookup — THE BENCHMARKED ENDPOINT.
       Its CGI twin lives at http://localhost/cgi-bin/verify.py
       Public and unauthenticated by design: an employer checking a
       badge has no account and should never need one.
       ================================================================ -->
  <servlet>
    <servlet-name>VerifyServlet</servlet-name>
    <servlet-class>com.badgeportal.VerifyServlet</servlet-class>
    <!-- Instantiate at startup rather than on the first request, so the
         very first timed request is not paying class-loading costs. -->
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>VerifyServlet</servlet-name>
    <url-pattern>/api/verify</url-pattern>
  </servlet-mapping>

  <!-- ================================================================
       Badge issuance
       ================================================================ -->
  <servlet>
    <servlet-name>IssueServlet</servlet-name>
    <servlet-class>com.badgeportal.IssueServlet</servlet-class>
    <load-on-startup>2</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>IssueServlet</servlet-name>
    <url-pattern>/api/issue</url-pattern>
  </servlet-mapping>

  <!-- ================================================================
       Student wallet (dynamic HTML rather than JSON)
       ================================================================ -->
  <servlet>
    <servlet-name>WalletServlet</servlet-name>
    <servlet-class>com.badgeportal.WalletServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>WalletServlet</servlet-name>
    <url-pattern>/wallet</url-pattern>
  </servlet-mapping>

  <!-- ================================================================
       Health / pool statistics
       ================================================================ -->
  <servlet>
    <servlet-name>HealthServlet</servlet-name>
    <servlet-class>com.badgeportal.HealthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HealthServlet</servlet-name>
    <url-pattern>/api/health</url-pattern>
  </servlet-mapping>

  <!-- ================================================================
       Authentication
       ================================================================ -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.badgeportal.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.badgeportal.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- ================================================================
       Role dashboards. Both sit behind AuthFilter above.
       ================================================================ -->
  <servlet>
    <servlet-name>AdminServlet</servlet-name>
    <servlet-class>com.badgeportal.AdminServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminServlet</servlet-name>
    <url-pattern>/admin/dashboard</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StudentServlet</servlet-name>
    <servlet-class>com.badgeportal.StudentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StudentServlet</servlet-name>
    <url-pattern>/student/dashboard</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

</web-app>
